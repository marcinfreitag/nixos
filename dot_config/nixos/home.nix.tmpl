{ config, pkgs,  ...}:

{
  home = {
    username = "{{ .linuxUserName }}";
    homeDirectory = "/home/{{ .linuxUserName }}";
#    packages = with pkgs; [
#      brave
#    ];
  };

  programs = {
    home-manager.enable = true;
    bash = {
      enable = true;
      shellAliases = {
        ff = "fastfetch";
        ga = "git add";
        gc = "git commit -m";
        gp = "git push";
        gpl = "git pull";
        gs = "git status";
      };
    };

    firefox = {
      enable = true;
        policies = {
          #BlockAboutConfig = true;
          DisableTelemetry = true;

          SearchEngines = {
            Default = "DuckDuckGo";
            PreventInstalls = true; # Prevents users from adding new engines manually
            Remove = [ "Google" "Bing" "Ecosia" "Perplexity" "Wikipedia (en)" ]; # Explicitly removes these engines
          };

    
          # Sperrt spezifische Preferences (lockPref equivalent)
          Preferences = {
            # Haupt-Schalter für maschinelles Lernen/KI-Features
            "browser.ml.enable" = { Value = false; Status = "locked"; };
            "browser.ml.chat.enabled" = { Value = false; Status = "locked"; };
            "browser.ml.chat.page" = { Value = false; Status = "locked"; };
            "browser.ml.linkPreview.enabled" = { Value = false; Status = "locked"; };
      
            # KI-gestützte Tab-Organisation und Alt-Texte
            "browser.tabs.groups.smart.enabled" = { Value = false; Status = "locked"; };
            "pdfjs.enableAltText" = { Value = false; Status = "locked"; };
      
            # Neue UI-Kontrollen (ab Firefox 148+) blockieren
            "browser.ai.control.default" = { Value = "blocked"; Status = "locked"; };
            "browser.ai.control.sidebarChatbot" = { Value = "blocked"; Status = "locked"; };
            "browser.ai.control.linkPreviewKeyPoints" = { Value = "blocked"; Status = "locked"; };
            "browser.ai.control.smartTabGroups" = { Value = "blocked"; Status = "locked"; };
      
            # Verhindert ML-basierte Erweiterungen
            "extensions.ml.enabled" = { Value = false; Status = "locked"; };
          };

          ExtensionSettings = {
            "uBlock0@raymondhill.net" = {
              default_area = "menupanel";
              install_url = "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi";
              installation_mode = "force_installed";
              private_browsing = true;
            };
          };
        };

      profiles = {
        default = {
          id = 0;
          name = "default";
          isDefault = true;
          settings = {
            "browser.startup.homepage" = "about:blank";
            "browser.startup.page" = 1;
            # Erzwingt den privaten Modus beim Start (entspricht "Niemals Chronik anlegen")
            "browser.privatebrowsing.autostart" = true;

            # Zusätzliche Absicherung: Chronik beim Beenden explizit löschen
            "privacy.sanitize.sanitizeOnShutdown" = true;
            "privacy.clearOnShutdown.history" = true;
            "privacy.clearOnShutdown.sessions" = true;

            # Suchvorschläge und Chronik in der Adressleiste deaktivieren
            "browser.urlbar.suggest.history" = false;
            "browser.urlbar.suggest.searches" = false;
      
            # Verhindert das Speichern von Formulardaten
            "browser.formfill.enable" = false;
          };
        };
      };
    };
  };
  nixpkgs.config.allowUnfree = true;
  home.stateVersion = "25.11";
}
